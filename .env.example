# GABTWIN_LLM_MAX_TOKENS=512   # 单轮回复上限；过小会截断长句末尾
# 运行数据目录，默认 <repo>/workspace
# GABTWIN_HOME=/opt/GabTwin/workspace
# 复制为 .env（chmod 600），填入自己的 key。.env 已被 .gitignore 忽略。

# 聊天默认走本地 Qwen2.5-7B（mlx-lm）；启动脚本会自动拉起 server 并导出下面三项。
# GABTWIN_LLM=local            # deepseek = 回云端
# GABTWIN_LLM_BASE=http://127.0.0.1:8080/v1
# GABTWIN_LLM_MODEL=/绝对路径/models/llm/qwen2.5-7b-4bit   # 服务端按这个路径加载
# GABTWIN_LLM_KEY=local

# 云端回退（GABTWIN_LLM=deepseek 时才用）
DEEPSEEK_API_KEY=

# 可选：兼容 OpenAI 协议的其他服务
# GABTWIN_LLM_BASE=https://api.deepseek.com
# GABTWIN_LLM_MODEL=deepseek-chat

# 可选：语音
# GABTWIN_TTS=qwen3tts   # 默认 Qwen3-TTS 1.7B Base；breeze / indextts / local 可切
# GABTWIN_TTS_FINAL=1   # 默认按 LLM 最终结果合成；=0 边收 delta 边合成
# GABTWIN_TTS_STREAM=1  # 流式 PCM；=0 回退整句
# GABTWIN_TTS_ONE_SHOT=1 # 默认整段一次生成（声调/音量一致）；=0 按标点分段
# GABTWIN_TTS_OVERLAP=1  # LLM 流式时先合成第一句，剩余等 LLM 结束整段合成（最多一个拼接点）
# GABTWIN_TTS_OVERLAP_MAX_FIRST=30  # 首句最多等多少字；超长句才退到最后一个逗号
# GABTWIN_TTS_OVERLAP_MIN_FIRST=12  # 首句至少攒多少字，避免“狸猫！”单独合成成一声喊
# Breeze 情绪稳定（高兴时不拔高音调、音量自动拉平）
# GABTWIN_BREEZE_INSTRUCT="Happy but restrained. Keep exactly the same pitch range, volume and timbre as the reference voice."
# GABTWIN_BREEZE_TEMPERATURE=0.0
# GABTWIN_BREEZE_CFG_SCALE=2.0
# GABTWIN_BREEZE_AGC=1
# GABTWIN_BREEZE_PITCH=1              # 每句中位 F0 限制（默认开）
# GABTWIN_BREEZE_PITCH_TARGET=220     # 目标中位 F0（Hz）
# GABTWIN_BREEZE_PITCH_MAX_SHIFT=4.0  # 单句最多移调半音数
# GABTWIN_BREEZE_PITCH_RANGE=3.0      # 句内 F0 偏离目标的半音上限
# GABTWIN_BREEZE_PITCH_COMPRESS=0.65  # 句内偏离压缩系数（越小越平）
# GABTWIN_ASR_CORRECT=1  # ASR 文本用本地 LLM 结合上下文校对；=0 关闭
# GABTWIN_TTS_SEGMENT_GAP_MS=350  # 分段之间额外静音
# GABTWIN_TTS_BACKLOG_MS=6000   # 播放队列积压超过这个值就等播放追上
# GABTWIN_TTS_SPEED=0.8   # Qwen3-TTS 语速；<1 更慢
# GABTWIN_TTS_PAUSE=1     # 标点停顿扩展；=0 关闭
# GABTWIN_TTS_PAUSE_MIN=300    # 只扩展 >=300ms 的真实静音
# GABTWIN_TTS_PAUSE_EXTRA=500  # 每个标点停顿额外追加 500ms
# GABTWIN_PTT=1   # 默认按住空格说话；=0 回到常开麦克风
# GABTWIN_SEGMENT_MERGE_MS=600   # 小停顿的两段 ASR 合并窗口
# GABTWIN_AEC=1   # 默认开启 AEC3；=0 回到播放时闭麦
# GABTWIN_AEC_DELAY_MS=100   # AEC 参考信号对齐延迟
# GABTWIN_BARGE_RMS=0.03     # 语音插话所需麦克风电平
# GABTWIN_MIN_SPEECH_RMS=0.008   # 段级能量门，挡噪声幻觉
# GABTWIN_MIN_SPEECH_MS=250
# GABTWIN_TTS=breeze   # 默认 qwen3tts；breeze / indextts / local 可切
# GABTWIN_BARGE_IN=1   # 耳机插话；默认 TTS 播放时闭麦，防止回声循环
# GABTWIN_DEVICE=外置麦克风
# GABTWIN_ENDPOINT=0.8
# GABTWIN_ENGINE=streaming    # 关闭句末 SenseVoice 定稿
# GABTWIN_OFFLINE_MODEL_DIR=/path/to/sensevoice
