{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GabTwin",
  "version": "0.1.0",
  "identifier": "app.gabtwin.dev",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GabTwin · 语音对话",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    }
  }
}
